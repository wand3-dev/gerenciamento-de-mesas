<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_panel"
    android:padding="20dp">

    <!-- Título do Diálogo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥 "
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTituloDialogServidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VINCULAR COMANDA À MESA"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtituloDialogServidor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Vincule e acompanhe os pedidos lançados para esta mesa."
        android:textColor="#64748B"
        android:textSize="11.5sp" />

    <!-- Campo 1 (Mesa) -->
    <TextView
        android:id="@+id/tvLabelCampo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NÚMERO DA MESA (1 a 34)"
        android:textColor="#0D9488"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogMesa"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#F1F5F9"
        android:hint="Ex: 5"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Campo 2 (Comanda) -->
    <TextView
        android:id="@+id/tvLabelCampo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="NÚMERO DA COMANDA (OPCIONAL)"
        android:textColor="#0D9488"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogComanda"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#F1F5F9"
        android:hint="Ex: 267 (ou em branco para todos)"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Status / Indicador de Carregamento -->
    <TextView
        android:id="@+id/tvStatusBuscaServidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#D97706"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Botão de Checar Atualizações -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerificarUpdatesDialog"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:text="🚀 VERIFICAR ATUALIZAÇÃO DO APP"
        android:textColor="#059669"
        android:textSize="11sp"
        android:textStyle="bold"
        app:strokeColor="#10B981"
        app:strokeWidth="1.5dp"
        app:cornerRadius="10dp"
        android:visibility="gone" />

    <!-- Botão Modo Tela Sempre Ativa -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleKeepScreenOn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="💡 MANTER TELA SEMPRE LIGADA: LIGADO"
        android:textColor="#0284C7"
        android:textSize="11sp"
        android:textStyle="bold"
        app:strokeColor="#38BDF8"
        app:strokeWidth="1.5dp"
        app:cornerRadius="10dp"
        android:visibility="gone" />

    <!-- Botões de Ação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelarBuscarServidor"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancelar"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConfirmarBuscarServidor"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_gradient_amber"
            android:text="Vincular Comanda"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
