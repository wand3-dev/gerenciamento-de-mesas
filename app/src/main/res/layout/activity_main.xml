<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- ═══════════════════════════════════════════════════════════════
         1. CABEÇALHO LUXUOSO (PORTUGÁLIA GOURMET & DASHBOARD)
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_luxury"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:elevation="8dp">

        <!-- Linha 1: Marca da Padaria Centralizada -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Nome da Padaria Perfeitamente Centralizado -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥐 "
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTUGÁLIA"
                        android:textColor="#FDE68A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="PADARIA &amp; RESTAURANTE"
                    android:textColor="#94A3B8"
                    android:textSize="8.5sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Faixa do Garçom com Estilo Moderno + Botão Modo Escuro -->
        <LinearLayout
            android:id="@+id/layoutUsuarioLogado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#162235"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNomeUsuarioLogado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 GARÇOM EM TURNO"
                android:textColor="#FDE68A"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnToggleTema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 ESCURO"
                android:textColor="#FDE68A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_server"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSairSessao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAIR 🚪"
                android:textColor="#F87171"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Dashboard de Métricas do Salão (Cards com cantos modernos) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Card 1: EM ATENDIMENTO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dashboard_card_emerald"
                android:layout_marginEnd="5dp"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EM ATENDIMENTO"
                    android:textColor="#86EFAC"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvResumoAbertas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Card 2: LIVRES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dashboard_card_slate"
                android:layout_marginEnd="5dp"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPONÍVEIS"
                    android:textColor="#94A3B8"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvResumoFechadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="34"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Card 3: FILA / ALERTA -->
            <LinearLayout
                android:id="@+id/layoutResumoAlertas"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dashboard_card_amber"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGUARDANDO"
                    android:textColor="#FDE68A"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvResumoAlertas15m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F59E0B"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Elementos ocultos para manter compatibilidade com código existente -->
        <TextView
            android:id="@+id/tvServerStatusTag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/btnConfigServidor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         2. BARRA DE ABAS PRINCIPAIS: MESAS vs FILA DE PEDIDOS
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#0F172A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Aba 1: MESAS -->
        <LinearLayout
            android:id="@+id/tabMesas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_pill_comanda"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/tvTabMesasTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪑 MESAS DO SALÃO (34)"
                android:textColor="#92400E"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aba 2: FILA DE PEDIDOS -->
        <LinearLayout
            android:id="@+id/tabFilaPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tvTabFilaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ FILA DE ESPERA (0)"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         3. BARRA DE BUSCA E FILTROS RÁPIDOS
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutFiltrosMesas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <!-- Linha da Busca + Botão Laranja Adicionar Comanda (+) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Barra de Busca Rápida: Mesa, Comanda ou Produto -->
            <LinearLayout
                android:id="@+id/layoutSearchContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etBuscarMesa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar mesa, comanda ou produto..."
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Botão Adicionar Comanda (Bolha Laranja com +) -->
            <LinearLayout
                android:id="@+id/btnAdicionarMesaServidor"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_bubble_amber"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chips de Filtro Modernos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnFiltroTodas"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_filter_chip_active"
                android:text="TODAS (34)"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFiltroAbertas"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:text="EM ATENDIMENTO"
                android:textColor="#065F46"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFiltroLivres"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:text="LIVRES"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sub-header da Aba Fila (Explicação, ordenação e filtros de setor) -->
    <LinearLayout
        android:id="@+id/layoutHeaderFila"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- Linha 1: Título e Botão Ocultar Entregues -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔥 Pedidos aguardando entrega no salão:"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLimparEntreguesFila"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:text="Ocultar Entregues"
                android:textColor="#475569"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Linha 2: Chips de Setor (Todas / Bebidas / Comidas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnFilaFiltroTodas"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_filter_chip_active"
                android:text="TODOS"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFilaFiltroBebidas"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:text="☕ BEBIDAS"
                android:textColor="#065F46"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFilaFiltroComidas"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_filter_chip_inactive"
                android:text="🍳 COMIDAS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         4. GRADE DE MESAS
    ═══════════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMesas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false" />

    <!-- ═══════════════════════════════════════════════════════════════
         5. LISTA DA FILA DE PEDIDOS
    ═══════════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilaPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>