<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- ═══════════════════════════════════════════════════════════════
         1. CABEÇALHO COMPACTO & MINIMALISTA
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_luxury"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Logo e Título à esquerda -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥐 "
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTUGÁLIA"
                        android:textColor="#FDE68A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNomeUsuarioLogado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitor de Comandas"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Ações do Servidor à direita -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Status Pill -->
                <TextView
                    android:id="@+id/tvStatusServidorPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dashboard_card_slate"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="● OFFLINE"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Botão Central Ligar / Desligar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLigarServidor"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="LIGAR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <!-- Botão Som de Nova Comanda (Sino / Mudo) -->
                <TextView
                    android:id="@+id/btnToggleSomAlerta"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:text="🔔"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Botão Configurações IP -->
                <TextView
                    android:id="@+id/btnConfigIpPorta"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         2. BARRA DE BUSCA RÁPIDA & STATUS DE SINCRONIZAÇÃO
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/layoutSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etBuscarMesa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar número da comanda ou doc..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13sp"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Última Sincronização Sutil -->
        <TextView
            android:id="@+id/tvUltimaSincronizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:text="Servidor desligado. Toque em LIGAR para iniciar."
            android:textColor="#64748B"
            android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         3. IDENTIFICADOR DA LISTA DE COMANDAS
    ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tabMonitor"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_pill_comanda"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvTabMonitorTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 COMANDAS ABERTAS (0)"
            android:textColor="#92400E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         4. ÁREA PRINCIPAL (COMANDAS / ESTADOS VAZIO E CARREGAMENTO)
    ═══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Estado Offline / Servidor Desconectado -->
        <LinearLayout
            android:id="@+id/layoutEmptyServidor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvEmptyServidorIcone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔌"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/tvEmptyServidorTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Servidor Desconectado"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyServidorDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Toque no botão abaixo para iniciar o monitoramento das comandas em tempo real."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyLigarServidor"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:text="▶ LIGAR SERVIDOR"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
        </LinearLayout>

        <!-- Estado Conectando ao Servidor -->
        <LinearLayout
            android:id="@+id/layoutConnectingServidor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="#0284C7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Consultando Comandas..."
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buscando no DataSnap..."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Lista de Comandas Monitoradas em Linha (Sem cards, Sem mesas) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvComandasMonitoradas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="14dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>