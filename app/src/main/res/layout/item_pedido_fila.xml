<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemFila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha Topo: Prioridade/Tempo + Badge Mesa + Badge Comanda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Badge Mesa em Destaque -->
            <TextView
                android:id="@+id/tvFilaMesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MESA 05"
                android:background="@drawable/bg_pill_status_aberta"
                android:textColor="#065F46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp" />

            <!-- Badge Comanda -->
            <TextView
                android:id="@+id/tvFilaComanda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CMD #227"
                android:background="@drawable/bg_pill_comanda"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Tag de Cronômetro / Urgência -->
            <TextView
                android:id="@+id/tvFilaTempoEspera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ há 18 min"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_danger"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <!-- Descrição do Pedido / Qtd de Itens -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFilaDescricao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comanda #227 (3 itens)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFilaValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 45,90"
                android:textColor="#D97706"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Informações secundárias: Horário do pedido e Documento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFilaHorarioDoc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido às 10:45:12 • Doc: 104523"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <!-- Botão Rápido: Marcar Entregue / Ver Mesa -->
            <TextView
                android:id="@+id/btnFilaAcaoEntregue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ MARCAR ENTREGUE"
                android:background="@drawable/bg_button_gradient_amber"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
