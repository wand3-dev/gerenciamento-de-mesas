<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_warning_banner"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚫"
        android:textSize="18sp"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCancDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1x PF Frango Grelhado"
            android:textColor="#991B1B"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCancMesaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mesa 04 • CMD #22 • 14:32:10"
            android:textColor="#B91C1C"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCancValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- R$ 22,99"
        android:textColor="#DC2626"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
