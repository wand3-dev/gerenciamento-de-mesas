<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutComandaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Container Principal da Comanda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Linha Superior: Mesa, Comanda, Cronômetro e Botão de Entrega -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Identificadores: Mesa + Comanda + Timer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Badge da Mesa -->
                <TextView
                    android:id="@+id/tvComandaMesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_comanda"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="MESA 04"
                    android:textColor="#92400E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Número da Comanda -->
                <TextView
                    android:id="@+id/tvComandaNumero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CMD #57"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <!-- Cronômetro de Espera -->
                <TextView
                    android:id="@+id/tvComandaTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="⏱ 00:03:27"
                    android:textColor="#475569"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Badge de Status: Concluída / Entregue (visível apenas quando todos os itens forem checados) -->
            <TextView
                android:id="@+id/tvComandaStatusEntregue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_status_livre"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ CONCLUÍDA"
                android:textColor="#059669"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Container dos Itens da Comanda (Produtos lançados) -->
        <LinearLayout
            android:id="@+id/layoutItensComanda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp"
            android:visibility="visible">
            <!-- As linhas dos produtos serão adicionadas aqui dinamicamente -->
        </LinearLayout>

        <!-- Rodapé da Comanda: Quantidade de Itens, Valor Total e Documento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvComandaQtdeItens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 itens"
                android:textColor="#64748B"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvComandaTotalValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 27,68"
                android:textColor="#059669"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvComandaDocumento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doc: 691386"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Linha divisória fina entre as comandas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

</LinearLayout>
